node_modules/
build/
dist/
coverage/

# Single package manager: npm (package-lock.json). Cloudflare Pages' build image
# ships Bun 1.2.15, which cannot parse bun.lock files written by Bun >= 1.4
# ("lockfileVersion": 2) and fails the frozen install. A committed bun.lock also
# makes Pages auto-select Bun over npm. See docs/growth/08-site-cleanup.md.
bun.lock
bun.lockb

# Generated during the build from content/blog/*.md. Do not commit preview or
# publication-specific modules; normal npm scripts regenerate these on demand.
src/data/scheduledBlogIndex.generated.ts
src/data/scheduledBlogPosts.generated.ts
src/data/scheduledBlogBodies.generated.ts
src/data/scheduledBengaliBlogs.generated.ts
src/data/scheduledBlogSeo.generated.ts

# Generated by scripts/prerender.ts from source content and image assets
/public/site-search-index.json
/public/og-image.jpg
/public/img/blog/
.DS_Store
*.log
.env*
!.env.example

# Video render scratch: intermediate stills, frames, font conversions and the
# full-bitrate master. The share-ready encode lives in docs/03-social/video/.
/.video/work/
/.video/check/
/.video/master/
/.video/out/
__pycache__/
