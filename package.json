{
  "name": "ural-travel",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:scheduled": "tsx scripts/generate-scheduled-blogs.ts",
    "dev": "npm run generate:scheduled && vite --port=3000 --host=0.0.0.0",
    "dev:drafts": "tsx scripts/generate-scheduled-blogs.ts --include-unpublished && vite --port=3000 --host=0.0.0.0",
    "build": "npm run generate:scheduled && vite build --mode production && tsx scripts/prerender.ts",
    "build:spa": "npm run generate:scheduled && vite build",
    "verify:build": "tsx scripts/verify-build.ts",
    "test:scheduling": "tsx scripts/test-scheduled-posts.ts",
    "scheduled:check": "tsx scripts/check-scheduled-posts.ts",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "npm run generate:scheduled && tsc --noEmit",
    "test:sitemaps": "tsx scripts/test-sitemaps.ts",
    "verify:sitemaps:live": "tsx scripts/verify-live-sitemaps.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "yaml": "^2.9.1"
  }
}
